        </member>
        <member name="P:Thought.Net.Telnet.TelnetPacket.PacketType">
            <summary>
                The type of packet.
            </summary>
        </member>
        <member name="T:Thought.Net.Telnet.TelnetPacketType">
            <summary>
                The type of data received by a remote system.
            </summary>
            <remarks>
                The Telnet protocol does not have "packets" in the formal sense.
                The <see cref="T:Thought.Net.Telnet.TelnetParser"/> class packages the incoming raw bytes
                into their appropriate types (e.g. data, commands, etc).  Each 
                chunk is called a packet by the class library.
            </remarks>
        </member>
        <member name="F:Thought.Net.Telnet.TelnetPacketType.Data">
            <summary>
                A packet containing data.
            </summary>
        </member>
        <member name="F:Thought.Net.Telnet.TelnetPacketType.Command">
            <summary>
                A packet containing an option command.
            </summary>
        </member>
        <member name="F:Thought.Net.Telnet.TelnetPacketType.Subnegotiation">
            <summary>
                A packet containing subnegotiation data.
            </summary>
        </member>
        <member name="T:Thought.Net.Telnet.TelnetParser">
            <summary>
                Parses incoming data from a Telnet connection.
            </summary>
        </member>
        <member name="F:Thought.Net.Telnet.TelnetParser.IAC">
            <summary>
                Marks the beginning of any telnet command or option.
            </summary>
            <remarks>
                The IAC character marks the beginning of any telnet command
                or option.  It is ASCII #255.  When this character is part of
                regular data (that is, not intended as an IAC character), it
                must be doubled (sent as two 0xFF characters).
            </remarks>
        </member>
        <member name="F:Thought.Net.Telnet.TelnetParser.socket">
            <summary>
                The socket to use for communications.
            </summary>
        </member>
        <member name="F:Thought.Net.Telnet.TelnetParser.state">
            <summary>
                The state of the protocol parser.
            </summary>
        </member>
        <member name="F:Thought.Net.Telnet.TelnetParser.unprocessed">
            <summary>
                Byte that have been received but are still unprocessed.
            </summary>
        </member>
        <member name="F:Thought.Net.Telnet.TelnetParser.unprocessedCount">
            <summary>
                The number of unprocessed bytes (the array might be larger).
            </summary>
        </member>
        <member name="F:Thought.Net.Telnet.TelnetParser.unprocessedIndex">
            <summary>
                The start of valid bytes in the unprocessed byte array.
            </summary>
        </member>
        <member name="M:Thought.Net.Telnet.TelnetParser.#ctor(System.Net.Sockets.Socket)">
            <summary>
            Initializes a new instance of the <see cref="T:Thought.Net.Telnet.TelnetParser"/> class.
            </summary>
            <param name="socket">The socket.</param>
            <exception cref="T:System.ArgumentNullException">socket</exception>
            <exception cref="T:System.IO.IOException"></exception>
        </member>
        <member name="M:Thought.Net.Telnet.TelnetParser.Close">
            <summary>
            Closes this instance.
            </summary>
        </member>
        <member name="M:Thought.Net.Telnet.TelnetParser.ReadNext">
            <summary>
                Reads the next <see cref="T:Thought.Net.Telnet.TelnetPacket"/> from the socket.
            </summary>
            <remarks>
                The next packet from the remote system.  If the packet regular
                or subnegotiation data, then the function will attempt to 
                load as much data as possible.
            </remarks>
        </member>
        <member name="M:Thought.Net.Telnet.TelnetParser.ReadNext(System.Nullable{System.Int32})">
            <summary>
                Reads the next <see cref="T:Thought.Net.Telnet.TelnetPacket"/> while limiting
                the number of bytes returned for a data or subnegotiation
                packet.
            </summary>
            <param name="maximumDataBytes">
                The maximum number of bytes to return in a data or
                subnegotiation packet.  Ignored for other packet types.
            </param>
            <returns>
                The next <see cref="T:Thought.Net.Telnet.TelnetPacket"/> from the remote system.
            </returns>
        </member>
