        <member name="T:Thought.Net.Telnet.ByteBuffer">
            <summary>
                A resizeable byte array.
            </summary>
        </member>
        <member name="F:Thought.Net.Telnet.ByteBuffer.DefaultCapacity">
            <summary>
                The default capacity of the buffer (in bytes) if an
                initial capacity is not specified by the developer.
            </summary>
        </member>
        <member name="F:Thought.Net.Telnet.ByteBuffer.count">
            <summary>
                The number of bytes stored in the buffer.
                This is not necessarily the actual length of
                the internal byte array.  It is the number of
                bytes as seen by the user.
            </summary>
        </member>
        <member name="F:Thought.Net.Telnet.ByteBuffer.buffer">
            <summary>
                The internal byte array managed by the class.
            </summary>
        </member>
        <member name="M:Thought.Net.Telnet.ByteBuffer.#ctor">
            <summary>
                Creates a buffer with the default capacity.
            </summary>
            <seealso cref="F:Thought.Net.Telnet.ByteBuffer.DefaultCapacity"/>
        </member>
        <member name="M:Thought.Net.Telnet.ByteBuffer.#ctor(System.Int32)">
            <summary>
                Creates a buffer with the specified capacity.
            </summary>
            <param name="capacity">The initial capacity of the buffer</param>
        </member>
        <member name="M:Thought.Net.Telnet.ByteBuffer.#ctor(System.Byte[])">
            <summary>
                Creates a buffer and initializes it with an existing byte array.
            </summary>
            <param name="data">The data to copy to the buffer.</param>
        </member>
        <member name="M:Thought.Net.Telnet.ByteBuffer.#ctor(System.Byte[],System.Int32,System.Int32)">
            <summary>
                Initializes the byte buffer with a subset of bytes
                from a byte array.
            </summary>
            <param name="data">
                A byte array containing data to copy to the byte buffer.
            </param>
            <param name="offset">
                The offset of the source array at which to begin copying bytes.
            </param>
            <param name="count">
                The number of bytes from the source array to copy to the buffer.
            </param>
        </member>
        <member name="M:Thought.Net.Telnet.ByteBuffer.Append(System.Byte)">
            <summary>
                Appends a byte to the end of the buffer.
            </summary>
            <param name="value">
                The byte to append.
            </param>
        </member>
        <member name="M:Thought.Net.Telnet.ByteBuffer.Append(System.Byte[])">
            <summary>
                Appends an array of bytes to the end of the buffer.
            </summary>
            <param name="bytes">
                A byte array containing the bytes to append.
            </param>
        </member>
        <member name="M:Thought.Net.Telnet.ByteBuffer.Append(System.Byte[],System.Int32,System.Int32)">
            <summary>
                Appends a subset of a byte array to the byte buffer.
            </summary>
            <param name="sourceArray">
                An array containing bytes to append to the buffer.
            </param>
            <param name="sourceIndex">
                The index of the source array at which to begin
                copying bytes into the buffer.
            </param>
            <param name="count">
                The number of bytes from the source array to
                append into the byte buffer.
            </param>
        </member>
        <member name="M:Thought.Net.Telnet.ByteBuffer.Clear">
            <summary>
                Clears the contents of the buffer.
            </summary>
            <remarks>
                The buffer is not necessarily resized (trimmed).  Clearing
                the buffer will not reduce the memory consumed by the buffer.
            </remarks>
        </member>
        <member name="M:Thought.Net.Telnet.ByteBuffer.CollapseDoubles(System.Byte)">
            <summary>
                Collapses doubled bytes (e.g. two 0xFF bytes are collapsed into a single 0xFF).
            </summary>
            <param name="value">The value to collapse.</param>
            <seealso cref="M:Thought.Net.Telnet.ByteBuffer.Double(System.Byte)"/>
        </member>
        <member name="M:Thought.Net.Telnet.ByteBuffer.Contains(System.Byte)">
            <summary>
                Searches for the specified value.
            </summary>
            <param name="value">The value to check.</param>
            <returns>True if the buffer contains the specified byte.</returns>
        </member>
        <member name="M:Thought.Net.Telnet.ByteBuffer.Double(System.Byte)">
            <summary>
                Doubles each instance of a value (e.g. a single 0xFF becomes two 0xFF bytes).
            </summary>
            <param name="value">The value to double.</param>
            <seealso cref="M:Thought.Net.Telnet.ByteBuffer.CollapseDoubles(System.Byte)"/>
        </member>
        <member name="M:Thought.Net.Telnet.ByteBuffer.EnsureCapacity(System.Int32)">
            <summary>
                Ensures the internal buffer can hold a minimum
                number of elements.
            </summary>
            <param name="minimum">
                The minimum capacity of the buffer after resizing.
            </param>
        </member>
        <member name="M:Thought.Net.Telnet.ByteBuffer.IndexOf(System.Byte)">
            <summary>
                Searches the buffer for a byte with a specified value.
            </summary>
            <param name="value">The value to locate in the buffer.</param>
            <returns>
                Returns the 0-based index of the first byte with the specified value,
                or -1 if no such byte has been stored in the buffer.
            </returns>
        </member>
        <member name="M:Thought.Net.Telnet.ByteBuffer.IndexOf(System.Byte,System.Int32)">
            <summary>
                Searches the buffer for a value located at or after a starting index.
            </summary>
            <param name="value">The value to locate in the buffer.</param>
            <param name="startIndex">The starting index to begin the search.</param>
            <returns>
                The zero-based index of the first value at or after the starting
                index, or -1 if the value could not be located.
            </returns>
        </member>
        <member name="M:Thought.Net.Telnet.ByteBuffer.Insert(System.Int32,System.Byte)">
            <summary>
                Inserts a byte into the buffer.
            </summary>
            <param name="index">
                The zero-based index in the buffer where the byte should be inserted.
            </param>
            <param name="value">
                The value to insert into the buffer.
            </param>
        </member>
        <member name="M:Thought.Net.Telnet.ByteBuffer.Insert(System.Int32,System.Byte[])">
            <summary>
                Inserts a byte array into the specified
                location of the buffer.
            </summary>
            <param name="index">
                The location where inserting should begin.
            </param>
            <param name="values">
                A byte array of values to insert into the buffer.
            </param>
        </member>
        <member name="M:Thought.Net.Telnet.ByteBuffer.RemoveAt(System.Int32)">
            <summary>
                Removes the byte at the specified index of the buffer.
            </summary>
            <param name="index">The zero-based index of the byte to remove.</param>
        </member>
        <member name="M:Thought.Net.Telnet.ByteBuffer.Replace(System.Byte,System.Byte[])">
            <summary>
            Replaces the specified value.
            </summary>
            <param name="value">The value.</param>
            <param name="newValues">The new values.</param>
            <exception cref="T:System.ArgumentNullException">newValues</exception>
        </member>
        <member name="M:Thought.Net.Telnet.ByteBuffer.ToArray">
            <summary>
                Copies the contents of the buffer to a new array.
            </summary>
            <returns>
                A new byte array containing the contents of the buffer.
            </returns>
        </member>
        <member name="P:Thought.Net.Telnet.ByteBuffer.Capacity">
            <summary>
                The capacity of the buffer.
            </summary>
            <remarks>
                The capacity reflects the number of bytes that can be stored
                in the buffer before a resize operation is necessary.  The
                capacity is always a positive number equal to or greater than
                the <see cref="P:Thought.Net.Telnet.ByteBuffer.Count"/> of bytes stored in the buffer.
            </remarks>
            <seealso cref="P:Thought.Net.Telnet.ByteBuffer.Count"/>
        </member>
        <member name="P:Thought.Net.Telnet.ByteBuffer.Count">
            <summary>
                The number of bytes stored in the buffer.
            </summary>
            <seealso cref="P:Thought.Net.Telnet.ByteBuffer.Capacity"/>
        </member>
        <member name="P:Thought.Net.Telnet.ByteBuffer.Item(System.Int32)">
            <summary>
                Gets or sets the byte at the specified index.
            </summary>
        </member>
        <member name="T:Thought.Net.Telnet.TelnetClient">
            <summary>
                Implements a Telnet client based on RFC 854 (Telnet Protocol
                Specification).
            </summary>
            
            <remarks>
            
                <para>
                    From the perspective of the protocol, both sides of
                    connections are peers -- neither is a true "server"
                    in the sense that it controls the flow of the protocol.
                    This is very different than command-oriented protocols like
                    POP3 or SMTP in which a client sends commands to the server
                    and receives responses.  In Telnet, both sides can send
                    commands and responses to each other.  Commands and
                    responses are embedded in the data being transferred.
                </para>
            
            </remarks>
        </member>
        <member name="F:Thought.Net.Telnet.TelnetClient.DefaultPort">
            <summary>
                The default telnet server port (23 decimal).
            </summary>
        </member>
        <member name="M:Thought.Net.Telnet.TelnetClient.#ctor">
            <summary>
                Initializes the basic Telnet options (private).
            </summary>
            <remarks>
                The default constructor is marked as private to ensure
                that only the parameterized constructors are called.  This
                may change in a future version of the software.
            </remarks>
        </member>
        <member name="M:Thought.Net.Telnet.TelnetClient.#ctor(System.Net.Sockets.Socket)">
            <summary>
                Creates a telnet client against a connected socket.
            </summary>
            <param name="socket">
                The socket to be used for sending and receiving data.
            </param>
        </member>
        <member name="M:Thought.Net.Telnet.TelnetClient.Close">
            <summary>
                Terminates the telnet connection.
            </summary>
            <remarks>
                This can be called multiple times without raising an exception.
            </remarks>
        </member>
        <member name="M:Thought.Net.Telnet.TelnetClient.DoingLocalOption(System.Byte)">
            <summary>
                Checks if the client is implementing an option.
            </summary>
            <param name="option">
                The Telnet option code.
            </param>
            <returns>
                True if the local client is implementing an option.    
            </returns>
        </member>
        <member name="M:Thought.Net.Telnet.TelnetClient.DoingRemoteOption(System.Byte)">
            <summary>
                Checks if the remote client is doing an option.
            </summary>
            <param name="option">
                The Telnet option code.
            </param>
            <returns>
                True if the remote client is implementing an option.
            </returns>
        </member>
