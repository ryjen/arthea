        <member name="T:Thought.Net.Telnet.TelnetStream">
            <summary>
                Provides a stream that implements the Telnet protocol.
            </summary>
            <seealso cref="P:Thought.Net.Telnet.TelnetStream.TelnetClient"/>
        </member>
        <member name="F:Thought.Net.Telnet.TelnetStream.canRead">
            <summary>
                Privately tracks the read capability of the stream.
            </summary>
        </member>
        <member name="F:Thought.Net.Telnet.TelnetStream.canWrite">
            <summary>
                Privately tracks the write capability of the stream.
            </summary>
        </member>
        <member name="F:Thought.Net.Telnet.TelnetStream.client">
            <summary>
                The underlying TelnetClient wrapped by the stream.
            </summary>
        </member>
        <member name="F:Thought.Net.Telnet.TelnetStream.ownsSocket">
            <summary>
                Privately tracks the ownership status.
            </summary>
            <remarks>
                If owned, the client will close (dispose) the socket when
                the class itself is closed.  Otherwise the client will
                simply release its reference to the socket.
            </remarks>
        </member>
        <member name="M:Thought.Net.Telnet.TelnetStream.#ctor">
            <summary>
                The default constructor is marked as private to
                ensure the parameterized constructor is called.
            </summary>
        </member>
        <member name="M:Thought.Net.Telnet.TelnetStream.#ctor(System.Net.Sockets.Socket)">
            <summary>
                Creates a Telnet stream against the specified socket.
            </summary>
            <param name="socket">
                The socket that the <see cref="T:Thought.Net.Telnet.TelnetStream"/> will use to send and receive data.
            </param>
        </member>
        <member name="M:Thought.Net.Telnet.TelnetStream.#ctor(System.Net.Sockets.Socket,System.IO.FileAccess,System.Boolean)">
            <summary>
                Creates a telnet stream against the specified
                socket with designated file access and ownership
                permissions.
            </summary>
            <param name="socket">
                The socket that the <see cref="T:Thought.Net.Telnet.TelnetStream"/> will use to send and receive data.
            </param>
            <param name="access">
                A bitwise combination of the FileAccess values that specifies the
                type of access given to the TelnetStream over the provided Socket.
            </param>
            <param name="ownsSocket">
                True to indicate that the TelnetStream will take ownership of the
                Socket; otherwise False.
            </param>
        </member>
        <member name="M:Thought.Net.Telnet.TelnetStream.#ctor(Thought.Net.Telnet.TelnetClient)">
            <summary>
            Initializes a new instance of the <see cref="T:Thought.Net.Telnet.TelnetStream"/> class.
            </summary>
            <param name="client">The client.</param>
            <exception cref="T:System.ArgumentNullException">client</exception>
        </member>
        <member name="M:Thought.Net.Telnet.TelnetStream.Close">
            <summary>
                Closes the Telnet stream and network connection.
            </summary>
        </member>
        <member name="M:Thought.Net.Telnet.TelnetStream.System#IDisposable#Dispose">
            <summary>
                Disposes (closes) the telnet stream.
            </summary>
        </member>
        <member name="M:Thought.Net.Telnet.TelnetStream.Flush">
            <summary>
                Ignored.
            </summary>
        </member>
        <member name="M:Thought.Net.Telnet.TelnetStream.Read(System.Byte[],System.Int32,System.Int32)">
            <summary>
                Copies bytes from the stream into an array.
            </summary>
            <param name="buffer">
                The buffer to which bytes are copied.
            </param>
            <param name="offset">
                The byte offset in the buffer at which to begin copying bytes.
            </param>
            <param name="count">
                The number of bytes to read.
            </param>
            <returns>The number of bytes read into the buffer.</returns>
        </member>
        <member name="M:Thought.Net.Telnet.TelnetStream.Seek(System.Int64,System.IO.SeekOrigin)">
            <summary>
                Not supported.
            </summary>
        </member>
        <member name="M:Thought.Net.Telnet.TelnetStream.SetLength(System.Int64)">
            <summary>
                Set the length of the stream (not supported).
            </summary>
        </member>
        <member name="M:Thought.Net.Telnet.TelnetStream.Write(System.Byte[],System.Int32,System.Int32)">
            <summary>
                Copies bytes to the telnet stream.
            </summary>
            <param name="buffer">
                The byte array from which to copy bytes to the stream.
            </param>
            <param name="offset">
                The offset in the buffer at which to begin copying bytes.
            </param>
            <param name="count">
                The number of bytes to copy to the stream.
            </param>
        </member>
        <member name="P:Thought.Net.Telnet.TelnetStream.CanRead">
            <summary>
                Gets a value indicating whether the TelnetStream supports reading.
            </summary>
            <value>
                True if the stream supports reading; False if the stream is closed
                or does not support reading.
            </value>
        </member>
        <member name="P:Thought.Net.Telnet.TelnetStream.CanSeek">
            <summary>
                Gets a value indicating whether the TelnetStream supports seeking.
            </summary>
            <value>
                Always false.
            </value>
        </member>
        <member name="P:Thought.Net.Telnet.TelnetStream.CanWrite">
            <summary>
                Gets a value indicating whether the stream supports writing.
            </summary>
            <value>
                True if the stream supports reading; false if the stream is closed
                or does not support reading.
            </value>
        </member>
        <member name="P:Thought.Net.Telnet.TelnetStream.Length">
            <summary>
                The stream length (not supported).
            </summary>
        </member>
        <member name="P:Thought.Net.Telnet.TelnetStream.OwnsSocket">
            <summary>
                Indicates whether or not the stream owns the socket.
            </summary>
            <remarks>
                If the stream owns the socket, then the socket will be closed
                when the stream is closed.  Otherwise the socket will be released
                without disposing.  This is useful when the stream is being used
                temporarily against an existing socket that is needed after the
                stream is finished.
            </remarks>
        </member>
        <member name="P:Thought.Net.Telnet.TelnetStream.Position">
            <summary>
                The stream position (not supported).
            </summary>
        </member>
        <member name="P:Thought.Net.Telnet.TelnetStream.TelnetClient">
            <summary>
                The underlying <see cref="P:Thought.Net.Telnet.TelnetStream.TelnetClient"/> of the stream.
            </summary>
            <seealso cref="P:Thought.Net.Telnet.TelnetStream.TelnetClient"/>
        </member>
