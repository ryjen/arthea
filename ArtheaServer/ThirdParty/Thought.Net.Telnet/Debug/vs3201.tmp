        <member name="T:Thought.Net.Telnet.TelnetCommand">
            <summary>
                A telnet command.
            </summary>
            <remarks>
                A telnet command is embedded in the stream of data being transferred
                from one side of the connection to the other.  A command begins
                with an IAC character (ASCII 255) followed by a byte that identifies
                the command.
            </remarks>
        </member>
        <member name="F:Thought.Net.Telnet.TelnetCommand.EndSubnegotiation">
            <summary>
                End Subnegotiation (SE)
            </summary>
            <remarks>
                This command indicates the end of subnegotiation data.
            </remarks>
            <seealso cref="F:Thought.Net.Telnet.TelnetCommand.Subnegotiation"/>
        </member>
        <member name="F:Thought.Net.Telnet.TelnetCommand.NoOperation">
            <summary>
                No operation (NOP)
            </summary>
        </member>
        <member name="F:Thought.Net.Telnet.TelnetCommand.DataMark">
            <summary>
                Data Mark
            </summary>
        </member>
        <member name="F:Thought.Net.Telnet.TelnetCommand.Break">
            <summary>
                Break (BRK)
            </summary>
        </member>
        <member name="F:Thought.Net.Telnet.TelnetCommand.InterruptProcess">
            <summary>
                Interrupt Process (IP)
            </summary>
        </member>
        <member name="F:Thought.Net.Telnet.TelnetCommand.AbortOutput">
            <summary>
                Abort output (AO)
            </summary>
        </member>
        <member name="F:Thought.Net.Telnet.TelnetCommand.AreYouThere">
            <summary>
                Are You There (AYT)
            </summary>
        </member>
        <member name="F:Thought.Net.Telnet.TelnetCommand.EraseCharacter">
            <summary>
                Erase Character (EC)
            </summary>
