        <member name="P:Thought.Net.Telnet.TelnetClient.Parser">
            <summary>
                The underlying parser of the telnet protocol.
            </summary>
            <remarks>
                The parser can be used to send advanced Telnet commands
                that are not supported by the TelnetClient class.  
            </remarks>
        </member>
