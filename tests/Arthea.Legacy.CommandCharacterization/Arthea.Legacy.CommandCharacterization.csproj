<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Directly compile original dispatcher, tokenizer, and contract. No legacy server. -->
    <Compile Include="../../ArtheaServer/Commands/Command.cs" Link="Legacy/Command.cs" />
    <Compile Include="../../ArtheaEngine/Argument.cs" Link="Legacy/Argument.cs" />
    <Compile Include="../../ArtheaEngine/ICommand.cs" Link="Legacy/ICommand.cs" />
    <Compile Include="../Arthea.Legacy.Characterization/LegacyNumberExtensionShim.cs"
             Link="TestSupport/LegacyNumberExtensionShim.cs" />
  </ItemGroup>
</Project>
