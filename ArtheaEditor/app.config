<!-- Database URI must come from ARTHEA_MONGODB_URI, never from version control. -->
<configuration>
  <appSettings><add key="appharbor.deploy_as_background_worker" value="false" /></appSettings>
  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" /></startup>
</configuration>
